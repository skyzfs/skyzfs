 #include <sys/epoll.h>
 #include <linux/falloc.h>
 
+#include <sys/mman.h>
+
 #include "ublksrv_tgt.h"
 
+/*
+ * SkyZFS test switches (tests/kernel/ublksrv-skz.patch). They turn the
+ * loop target into a stand-in for skyzfsd in the kernel rig. All come
+ * from the environment of `ublk add` or `ublk recover`; none set, the
+ * target behaves as upstream apart from not advertising FUA.
+ *
+ *   SKZ_STATS=FILE        counters, ten native u64 (see enum skz_stat),
+ *                         in a shared mapping: they survive kill -9
+ *   SKZ_FAIL_AFTER=N      after N writes, write-zeroes and discards the
+ *                         volume has failed: every request, reads
+ *                         included, completes with -EIO. Kept in the
+ *                         counters, so a recovered server is failed too
+ *   SKZ_FAIL_FILE=FILE    the volume fails as soon as FILE exists
+ *   SKZ_HOLD=SECONDS:read:OFFSET, SECONDS:write:OFFSET or SECONDS:flush
+ *                         the first request of that kind that covers
+ *                         that byte is held that long before it is served
+ *   SKZ_DROP_EVERY=K      every Kth write is acknowledged and not
+ *                         written: a deliberately wrong server
+ *   SKZ_COMMIT_DELAY_MS=N a write, write-zeroes or discard is applied
+ *                         and then waits N ms before it is completed
+ *                         to the kernel. A server killed in that time
+ *                         leaves requests applied and not acknowledged;
+ *                         how many is the counter SKZ_UNACKED, which
+ *                         the dead server leaves behind and the next
+ *                         one sets to zero when it starts. It counts
+ *                         from the completion of the write to the file:
+ *                         a request killed while that write was under
+ *                         way may be applied and is not counted
+ *   SKZ_COMMIT_DELAY_BEFORE=1  the same wait, before the request is
+ *                         applied: nothing is ever applied and not
+ *                         acknowledged for longer than the write takes
+ *
+ * Always: a write, write-zeroes or discard that overlaps one that is
+ * still being applied waits until that one is applied. Upstream issues
+ * every request to the backing file as it arrives, with direct I/O, and
+ * two overlapping writes in flight together can then each win some of
+ * the blocks (seen in run 43010288006). The SkyZFS contract has
+ * overlapping operations in flight apply whole, in some order.
+ *   SKZ_UNORDERED=1       not so: as upstream, a deliberately wrong server
+ *   SKZ_TEAR=1            a write of the range another write had less
+ *                         than 2 ms before is applied in its first half
+ *                         only, after that one, and acknowledged whole:
+ *                         a server that tears overlapping writes every
+ *                         time, whatever the storage under it does
+ *
+ * One queue only: the counters are not atomic.
+ */
+enum skz_stat { SKZ_READS, SKZ_WRITES, SKZ_FLUSHES, SKZ_DISCARDS,
+	SKZ_WRITE_ZEROES, SKZ_FAILED_REQS, SKZ_HELD, SKZ_FAILED, SKZ_UNACKED,
+	SKZ_SPARE, SKZ_NR };
+static __u64 skz_private[SKZ_NR];
+static __u64 *skz = skz_private;
+static long skz_fail_after = -1;
+static const char *skz_fail_file;
+static long skz_drop_every;
+static int skz_hold_op = -1;
+static struct __kernel_timespec skz_hold_ts;
+static __u64 skz_hold_sector;
+static struct __kernel_timespec skz_delay_ts;
+static bool skz_delay;
+static bool skz_delay_before;
+
+/* The sectors of each mutation that is being applied, by tag. */
+#define SKZ_MAX_TAGS 4096
+static struct { __u64 start, end; bool busy; } skz_applying[SKZ_MAX_TAGS];
+static struct __kernel_timespec skz_retry_ts = { 0, 1000000 };	/* 1 ms */
+
+static bool skz_unordered;
+static bool skz_tear;
+static __u64 skz_last_start, skz_last_end, skz_last_ns;
+
+static __u64 skz_now_ns(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (__u64)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+
+/* True if this write follows one of the same range closely (SKZ_TEAR). */
+static bool skz_follows_same_range(const struct ublksrv_io_desc *iod)
+{
+	__u64 start = iod->start_sector, end = start + iod->nr_sectors;
+	__u64 now = skz_now_ns();
+	bool follows = start == skz_last_start && end == skz_last_end &&
+		now - skz_last_ns < 2000000ULL;
+
+	skz_last_start = start;
+	skz_last_end = end;
+	skz_last_ns = now;
+	return follows;
+}
+
+static bool skz_overlaps_one_applying(const struct ublksrv_io_desc *iod)
+{
+	__u64 start = iod->start_sector, end = start + iod->nr_sectors;
+	int i;
+
+	if (skz_unordered)
+		return false;
+
+	for (i = 0; i < SKZ_MAX_TAGS; i++)
+		if (skz_applying[i].busy && skz_applying[i].start < end &&
+				start < skz_applying[i].end)
+			return true;
+	return false;
+}
+
+static bool skz_mutates(unsigned ublk_op)
+{
+	return ublk_op == UBLK_IO_OP_WRITE || ublk_op == UBLK_IO_OP_DISCARD ||
+		ublk_op == UBLK_IO_OP_WRITE_ZEROES;
+}
+
+static void skz_init(void)
+{
+	const char *v;
+
+	if ((v = getenv("SKZ_STATS")) != NULL) {
+		int fd = open(v, O_RDWR | O_CREAT, 0644);
+		void *m = MAP_FAILED;
+
+		if (fd >= 0 && ftruncate(fd, sizeof(skz_private)) == 0)
+			m = mmap(NULL, sizeof(skz_private), PROT_READ | PROT_WRITE,
+					MAP_SHARED, fd, 0);
+		if (fd >= 0)
+			close(fd);
+		if (m == MAP_FAILED)
+			ublk_err("skz: cannot map %s\n", v);
+		else
+			skz = (__u64 *)m;
+	}
+	/* what the server before this one left applied and unacknowledged
+	 * has been read by whoever started this one */
+	skz[SKZ_UNACKED] = 0;
+	if ((v = getenv("SKZ_COMMIT_DELAY_MS")) != NULL && strtol(v, NULL, 10) > 0) {
+		long ms = strtol(v, NULL, 10);
+
+		skz_delay = true;
+		skz_delay_ts.tv_sec = ms / 1000;
+		skz_delay_ts.tv_nsec = (ms % 1000) * 1000000L;
+		v = getenv("SKZ_COMMIT_DELAY_BEFORE");
+		skz_delay_before = v != NULL && !strcmp(v, "1");
+	}
+	v = getenv("SKZ_UNORDERED");
+	skz_unordered = v != NULL && !strcmp(v, "1");
+	v = getenv("SKZ_TEAR");
+	skz_tear = v != NULL && !strcmp(v, "1");
+	if ((v = getenv("SKZ_FAIL_AFTER")) != NULL)
+		skz_fail_after = strtol(v, NULL, 10);
+	skz_fail_file = getenv("SKZ_FAIL_FILE");
+	if ((v = getenv("SKZ_DROP_EVERY")) != NULL)
+		skz_drop_every = strtol(v, NULL, 10);
+	if ((v = getenv("SKZ_HOLD")) != NULL) {
+		const char *op = strchr(v, ':');
+		const char *off = op ? strchr(op + 1, ':') : NULL;
+
+		skz_hold_ts.tv_sec = strtol(v, NULL, 10);
+		if (op && !strncmp(op + 1, "read:", 5))
+			skz_hold_op = UBLK_IO_OP_READ;
+		else if (op && !strncmp(op + 1, "write:", 6))
+			skz_hold_op = UBLK_IO_OP_WRITE;
+		else if (op && !strcmp(op + 1, "flush"))
+			skz_hold_op = UBLK_IO_OP_FLUSH;
+		if (off)
+			skz_hold_sector = strtoull(off + 1, NULL, 10) >> 9;
+	}
+}
+
+/* Counts the request. True if the volume has failed and it must get -EIO. */
+static bool skz_count_and_failed(unsigned ublk_op)
+{
+	bool append = false;
+
+	switch (ublk_op) {
+	case UBLK_IO_OP_READ:
+		skz[SKZ_READS]++;
+		break;
+	case UBLK_IO_OP_WRITE:
+		skz[SKZ_WRITES]++;
+		append = true;
+		break;
+	case UBLK_IO_OP_FLUSH:
+		skz[SKZ_FLUSHES]++;
+		break;
+	case UBLK_IO_OP_DISCARD:
+		skz[SKZ_DISCARDS]++;
+		append = true;
+		break;
+	case UBLK_IO_OP_WRITE_ZEROES:
+		skz[SKZ_WRITE_ZEROES]++;
+		append = true;
+		break;
+	}
+	if (!skz[SKZ_FAILED] && skz_fail_file && access(skz_fail_file, F_OK) == 0)
+		skz[SKZ_FAILED] = 1;
+	if (!skz[SKZ_FAILED] && append && skz_fail_after >= 0 &&
+			skz[SKZ_WRITES] + skz[SKZ_DISCARDS] + skz[SKZ_WRITE_ZEROES] >
+			(__u64)skz_fail_after)
+		skz[SKZ_FAILED] = 1;
+	if (skz[SKZ_FAILED])
+		skz[SKZ_FAILED_REQS]++;
+	return skz[SKZ_FAILED] != 0;
+}
+
