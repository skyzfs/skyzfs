== the change
diff --git a/crates/skyzfs-upload/src/remote.rs b/crates/skyzfs-upload/src/remote.rs
index 20d2f4c..7a3c8fe 100644
--- a/crates/skyzfs-upload/src/remote.rs
+++ b/crates/skyzfs-upload/src/remote.rs
@@ -221,7 +221,7 @@ where
             row,
             head_group: engine.head_group(),
             current: engine.head_commit_hash() == head.commit,
-            head: head.commit,
+            head: engine.head_commit_hash(),
         })
     }
 
