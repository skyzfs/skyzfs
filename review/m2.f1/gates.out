== tests.sh
#!/bin/bash
cd <tree>
S=$1
export CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 RUST_BACKTRACE=0
echo "== test plain"; cargo test --workspace > $S/test_plain.out 2>&1; echo "test plain exit $?"
df -h / | tail -1
echo "== test hooks"; cargo test -p skyzfsd -p skyzfs-local --features skyzfsd/test-hooks,skyzfs-local/test-hooks > $S/test_hooks.out 2>&1; echo "test hooks exit $?"
df -h / | tail -1
echo "== test ctl"; cargo test -p skyzfs-ublk-sys --features control-test-program > $S/test_ctl.out 2>&1; echo "test ctl exit $?"
df -h / | tail -1

