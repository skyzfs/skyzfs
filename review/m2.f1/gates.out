# Gates at acda3e7, main tree, rustc 1.100.0 (2026-11-09), the current stable.
# The first run of the tests ran out of disk; they were run again with
# CARGO_INCREMENTAL=0 CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0 (tests.sh).

== run.sh (fmt and clippy)
#!/bin/bash
cd <tree>
S=$1
echo "== fmt"; cargo fmt --all -- --check > $S/fmt.out 2>&1; echo "fmt exit $?"
echo "== clippy plain"; cargo clippy --workspace --all-targets -- -D warnings > $S/clippy_plain.out 2>&1; echo "clippy plain exit $?"
echo "== clippy hooks"; cargo clippy -p skyzfsd --all-targets --features test-hooks -- -D warnings > $S/clippy_hooks.out 2>&1; echo "clippy hooks exit $?"
echo "== clippy ctl"; cargo clippy -p skyzfs-ublk-sys --all-targets --features control-test-program -- -D warnings > $S/clippy_ctl.out 2>&1; echo "clippy ctl exit $?"
echo "== test plain"; cargo test --workspace > $S/test_plain.out 2>&1; echo "test plain exit $?"
echo "== test hooks"; cargo test -p skyzfsd --features test-hooks > $S/test_hooks.out 2>&1; echo "test hooks exit $?"
echo "== test ctl"; cargo test -p skyzfs-ublk-sys --features control-test-program > $S/test_ctl.out 2>&1; echo "test ctl exit $?"

