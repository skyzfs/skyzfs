+/// RH (review of #167): what the engine keeps of a publish (its memory)
+/// does not outlast the publish: published or given up, across many
+/// rounds, nothing is kept for a long-lived `run`.
+#[test]
+fn rh_the_memory_of_a_publish_goes_with_it() {
+    let world = World::new(Mode::Busy);
+    let keep = MemKeep::default();
+    let mut a = agent(&world, &keep);
+    for _ in 0..3 {
+        a.begin().expect("begun");
+        a.settle(LIMIT).expect("settled");
+    }
+    assert_eq!(world.borrow().refs.len(), 3);
+    assert!(a.memory.is_empty(), "{:?}", a.memory.keys().collect::<Vec<_>>());
+}
