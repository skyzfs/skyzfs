+    #[test]
+    fn probe_a_read_in_flight_at_a_kill() {
+        let history = |kill: bool| {
+            let mut c = Client::new();
+            let r = c.read(0, 1);
+            c.wrote(0, 1, 5);
+            if kill {
+                c.model.kill();
+            }
+            c.returns(r, vec![0; B]).is_ok()
+        };
+        println!("PROBE a read submitted before a write, returning the state before it: without a kill {}, with a kill between {}", history(false), history(true));
+    }
