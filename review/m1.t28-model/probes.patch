+    // ---- REVIEW PROBES (not part of the pull request) ----
+    #[test]
+    fn probe_worlds_at_a_kill() {
+        for k in 1..=4u64 {
+            let mut c = Client::new();
+            let ids: Vec<_> = (0..k).map(|b| c.write(b, 1, 1 + b as u8)).collect();
+            let before = c.model.worlds();
+            c.model.kill();
+            let at = c.model.worlds();
+            for id in ids {
+                c.ack(id);
+            }
+            println!("PROBE worlds: {k} lone writes in flight: {before} before the kill, {at} after it, {} after their acknowledgements", c.model.worlds());
+        }
+        // Overlapping: W1 0..2, W2 1..2, W3 1..3 in flight, W2 acknowledged.
+        let mut c = Client::new();
+        let w1 = c.write(0, 2, 1);
+        let w2 = c.write(1, 1, 2);
+        let w3 = c.write(1, 2, 3);
+        c.ack(w2);
+        c.model.kill();
+        println!("PROBE worlds: three overlapping, one acknowledged: {} after the kill", c.model.worlds());
+        c.ack(w1);
+        c.ack(w3);
+        println!("PROBE worlds: ... {} after the acknowledgements", c.model.worlds());
+    }
