+    #[test]
+    fn probe_power_cut_after_outcome_3() {
+        let history = |fills: [u8; 2]| {
+            let mut c = Client::new();
+            let w1 = c.write(0, 2, 1);
+            let w2 = c.write(1, 1, 2);
+            c.ack(w2);
+            c.model.kill();
+            c.ack(w1);
+            c.model.power_cut();
+            c.would_see(0, &fills)
+        };
+        println!(
+            "PROBE cut after the kill and W1's acknowledgement, no flush: [1,2] {}, [1,1] {}, [0,2] {}, [1,0] {}, [0,0] {}",
+            history([1, 2]), history([1, 1]), history([0, 2]), history([1, 0]), history([0, 0])
+        );
+    }
