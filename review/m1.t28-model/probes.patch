+    #[test]
+    fn probe_two_kills() {
+        let history = |block_1: u8| {
+            let mut c = Client::new();
+            let w1 = c.write(0, 2, 1);
+            let w2 = c.write(1, 1, 2);
+            c.ack(w2);
+            c.model.kill();
+            c.model.kill();
+            c.ack(w1);
+            c.would_see(0, &[1, block_1])
+        };
+        println!("PROBE two kills: W2 on block 1 {}, W1 on block 1 {}, neither {}", history(2), history(1), history(0));
+    }
