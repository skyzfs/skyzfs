+    #[test]
+    fn probe_fully_covered_request_never_applied() {
+        // W1 block 1, W2 block 1, in flight together; W2 acknowledged; kill;
+        // W1 acknowledged. The target never applied W1 at all.
+        let mut c = Client::new();
+        let w1 = c.write(1, 1, 1);
+        let w2 = c.write(1, 1, 2);
+        c.ack(w2);
+        c.model.kill();
+        c.ack(w1);
+        println!("PROBE W1 wholly under W2, W1 never applied by anyone: accepted {}", c.would_see(1, &[2]));
+        // W1 covers one block more: the block W2 does not cover shows it.
+        let mut c = Client::new();
+        let w1 = c.write(0, 2, 1);
+        let w2 = c.write(1, 1, 2);
+        c.ack(w2);
+        c.model.kill();
+        c.ack(w1);
+        println!("PROBE W1 partly under W2, W1 never applied: accepted {}", c.would_see(0, &[0, 2]));
+    }
