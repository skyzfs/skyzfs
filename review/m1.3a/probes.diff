+/// PROBE 4. Chains of starts, detaches, kills at any step, clients that
+/// hold devices, strangers' devices (twins and others, with and without
+/// another volume's note) and a lost run directory. Checked after every
+/// step: nothing but this volume's own device is deleted or recovered,
+/// a deleted-and-held device is never touched again, and a start that
+/// serves leaves no other device of this volume that a client could
+/// hold.
+#[test]
+fn probe_chains_of_kills_starts_and_detaches() {
+    let mut seed = 0x9E37_79B9_7F4A_7C15u64;
+    let mut next = move |n: u64| {
+        seed ^= seed << 13;
+        seed ^= seed >> 7;
+        seed ^= seed << 17;
+        seed % n
+    };
+    let twin = Shape {
+        size: SIZE,
+        queues: WANTED.queues,
+        depth: WANTED.depth,
+        flags: WANTED.flags,
+    };
+    let mut served = 0;
+    let mut stopped = 0;
+    for trial in 0..20_000 {
+        let mut world = World::new();
+        let mut ours: Vec<u32> = Vec::new();
+        let mut log: Vec<String> = Vec::new();
+        for _ in 0..8 {
+            let before = world.devices.clone();
+            world.events.clear();
+            world.dies_at = None;
+            let action = next(10);
+            let mut result = None;
+            match action {
+                0..=3 => {
+                    // A start, killed or not.
+                    if action >= 2 {
+                        world.dies_at = Some(next(14) as usize);
+                    }
+                    log.push(format!("start dies_at={:?}", world.dies_at));
+                    let outcome = run(world, 0);
+                    world = outcome.world;
+                    result = Some(outcome.result);
+                }
+                4 | 5 => {
+                    if action == 5 {
+                        world.dies_at = Some(next(7) as usize);
+                    }
+                    log.push(format!("detach dies_at={:?}", world.dies_at));
+                    let (mut c, mut r, shared) = fakes(world);
+                    let _ = detach(&mut c, &mut r);
+                    drop((c, r));
+                    world = match Rc::try_unwrap(shared) {
+                        Ok(cell) => cell.into_inner(),
+                        Err(_) => panic!("the fakes are dropped"),
+                    };
+                }
+                6 | 7 => {
+                    // A stranger's device on the lowest free number.
+                    let number = (0..).find(|n| !world.devices.contains_key(n)).unwrap();
+                    let state = STATES[next(3) as usize];
+                    let shape = if next(2) == 0 { twin } else { EARLIER };
+                    world.devices.insert(number, DeviceInfo { state, shape });
+                    ours.retain(|n| *n != number);
+                    if next(2) == 0 {
+                        world.notes.insert(number, [0xEE; 16]);
+                    } else {
+                        world.notes.remove(&number);
+                    }
+                    log.push(format!("stranger {number} {state:?} twin={}", shape == twin));
+                }
+                8 => {
+                    // Clients let go of deleted devices.
+                    let dead: Vec<u32> = world
+                        .devices
+                        .iter()
+                        .filter(|(_, d)| d.state == DeviceState::Dead)
+                        .map(|(n, _)| *n)
+                        .collect();
+                    for n in dead {
+                        world.devices.remove(&n);
+                        world.held.retain(|h| *h != n);
+                        ours.retain(|o| *o != n);
+                    }
+                    log.push("clients let go".into());
+                }
+                _ => {
+                    if next(4) == 0 {
+                        world.notes.clear();
+                        log.push("run directory lost".into());
+                    }
+                }
+            }
+            let context = || format!("trial {trial}: {log:?}\nevents {:?}", world.events);
+            for event in &world.events {
+                match event {
+                    Event::Add(n, true) => ours.push(*n),
+                    Event::Delete(n) => {
+                        assert!(ours.contains(n), "deleted another's device {n}\n{}", context());
+                        assert!(
+                            before.get(n).map(|d| d.state) != Some(DeviceState::Dead)
+                                && before.get(n).map(|d| d.state) != Some(DeviceState::Live),
+                            "deleted a live or dead device {n}\n{}",
+                            context()
+                        );
+                    }
+                    Event::BeginRecovery(n) => {
+                        assert!(
+                            ours.contains(n)
+                                && before.get(n).map(|d| d.state) == Some(DeviceState::Waiting),
+                            "recovered device {n}, not this volume's waiting device\n{}",
+                            context()
+                        );
+                    }
+                    _ => {}
+                }
+            }
+            ours.retain(|n| world.devices.contains_key(n));
+            match result {
+                Some(Ok(ready)) => {
+                    served += 1;
+                    let others: Vec<u32> = ours
+                        .iter()
+                        .copied()
+                        .filter(|n| {
+                            *n != ready.number
+                                && matches!(
+                                    world.devices[n].state,
+                                    DeviceState::Live | DeviceState::Waiting
+                                )
+                        })
+                        .collect();
+                    assert!(
+                        others.is_empty(),
+                        "serves {} and this volume's {others:?} can be held\n{}",
+                        ready.number,
+                        context()
+                    );
+                    // It serves, a client may open it, and it is killed
+                    // or not before the next step.
+                    let device = world.devices.get_mut(&ready.number).expect("served");
+                    device.state = if next(3) == 0 {
+                        DeviceState::Live
+                    } else {
+                        DeviceState::Waiting
+                    };
+                    if next(2) == 0 && !world.held.contains(&ready.number) {
+                        world.held.push(ready.number);
+                    }
+                }
+                Some(Err(_)) => stopped += 1,
+                None => {}
+            }
+            // A live device of ours whose daemon is not this step's is
+            // seen as waiting by the next step (the daemon was killed).
+            for n in &ours {
+                if let Some(d) = world.devices.get_mut(n) {
+                    if d.state == DeviceState::Live && next(2) == 0 {
+                        d.state = DeviceState::Waiting;
+                    }
+                }
+            }
+        }
+    }
+    assert!(served > 1000 && stopped > 100, "{served} served, {stopped} stopped");
+}
