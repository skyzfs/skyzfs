+/// PROBE 3 (review; not part of the pull request). `Served::submit`
+/// answers "busy" once its worker is gone. A request that is fetched in
+/// the turn that would notice is submitted before the pump looks, and
+/// the pump reports a broken contract and not a gone target.
+#[test]
+#[ignore = "review probe: fails at 5716df5"]
+fn probe_a_gone_target_with_a_request_waiting_is_reported_as_gone() {
+    let mut rig = Rig::new(0, 8, 8);
+    rig.fetch(&[write(0, 0)]);
+    rig.pump.target().gone = true;
+    rig.pump.target().busy_when_gone = true;
+    assert_eq!(rig.fetch(&[write(1, 1)]), Some(Stopped::TargetGone));
+}
