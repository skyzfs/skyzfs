+/// PROBE 1. The acknowledged position is read once, before the lock is
+/// tried. An instance that waits for the lock while the old one still
+/// serves opens with the position as it was when it first looked.
+#[test]
+#[ignore = "review probe: fails at 5716df5"]
+fn probe_the_position_is_the_one_stored_when_the_lock_was_got() {
+    let mut world = World::new();
+    world.acknowledged = Ok(Some(MustReach {
+        identity: world.identity,
+        position: 10,
+    }));
+    world.opens.push_back(OpenError::Locked);
+    let shared = Rc::new(RefCell::new(world));
+    let (mut c, mut r, mut v) = (
+        Fake(shared.clone()),
+        Advancing(Fake(shared.clone())),
+        Fake(shared.clone()),
+    );
+    let result = start_with(&mut c, &mut r, &mut v, &WANTED, Mutants::default());
+    let w = shared.borrow();
+    let opens: Vec<_> = w
+        .events
+        .iter()
+        .filter(|e| matches!(e, Event::Open(..)))
+        .collect();
+    assert!(
+        matches!(result, Err(Stop::Failed(_))),
+        "log ends at {}, 5000 was acknowledged, and the start gave {result:?} after {opens:?}",
+        w.log_end
+    );
+}
