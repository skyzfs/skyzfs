+/// Records whose pause is the moment the instance that still holds the
+/// lock acknowledges more, and then dies with a log that lost it.
+struct Advancing(Fake);
+
+impl Records for Advancing {
+    fn boot(&self) -> [u8; 16] {
+        self.0.boot()
+    }
+    fn nonce(&mut self) -> io::Result<[u8; 16]> {
+        self.0.nonce()
+    }
+    fn attachment(&mut self) -> io::Result<Option<Attachment>> {
+        self.0.attachment()
+    }
+    fn write_attachment(&mut self, a: &Attachment) -> io::Result<()> {
+        self.0.write_attachment(a)
+    }
+    fn note(&mut self, n: u32) -> io::Result<Option<[u8; 16]>> {
+        self.0.note(n)
+    }
+    fn write_note(&mut self, n: u32, nonce: &[u8; 16]) -> io::Result<()> {
+        self.0.write_note(n, nonce)
+    }
+    fn remove_attachment(&mut self) -> io::Result<()> {
+        self.0.remove_attachment()
+    }
+    fn remove_note(&mut self, n: u32) -> io::Result<()> {
+        self.0.remove_note(n)
+    }
+    fn acknowledged(&mut self) -> io::Result<Option<MustReach>> {
+        self.0.acknowledged()
+    }
+    fn pause(&mut self) {
+        {
+            let mut w = (self.0).0.borrow_mut();
+            let identity = w.identity;
+            // The serving instance acknowledged up to 5000 ...
+            w.acknowledged = Ok(Some(MustReach {
+                identity,
+                position: 5000,
+            }));
+            // ... and the log that comes back ends at 1000.
+        }
+        self.0.pause();
+    }
+}
