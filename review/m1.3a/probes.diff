+/// PROBE 2a. `detach` looks, a daemon takes the waiting device over and
+/// serves it, and `detach` deletes it: a device with a live server.
+#[test]
+#[ignore = "review probe: fails at 5716df5"]
+fn probe_a_detach_overtaken_by_a_start_deletes_no_served_device() {
+    let world = World::new().attached(4, DeviceState::Waiting, EARLIER);
+    let shared = Rc::new(RefCell::new(world));
+    let mut control = Overtaken {
+        inner: Fake(shared.clone()),
+        calls: 0,
+        at: 0, // right after detach's look at the device
+        started: None,
+    };
+    let mut records = Fake(shared.clone());
+    let detached = detach(&mut control, &mut records);
+    let started = control.started.take().expect("the start ran");
+    let w = shared.borrow();
+    assert!(
+        started.as_ref().is_ok_and(|r| r.took_over && r.number == 4),
+        "{started:?}"
+    );
+    assert!(
+        w.devices.contains_key(&4) && w.attachment.is_some(),
+        "the daemon serves device 4; detach answered {detached:?}; devices {:?}, record {:?}",
+        w.devices,
+        w.attachment
+    );
+}
+
+/// PROBE 2b. `detach` deletes a device that was never started, a daemon
+/// starts and attaches afresh, and `detach` removes the record the
+/// daemon has just written. The daemon is killed, and the next start
+/// gives the volume a second device.
+#[test]
+#[ignore = "review probe: fails at 5716df5"]
+fn probe_a_detach_overtaken_by_a_start_leaves_the_new_record() {
+    let world = World::new().attached(4, DeviceState::Added, EARLIER);
+    let shared = Rc::new(RefCell::new(world));
+    let mut control = Overtaken {
+        inner: Fake(shared.clone()),
+        calls: 0,
+        at: 1, // detach's look after its delete
+        started: None,
+    };
+    let mut records = Fake(shared.clone());
+    let detached = detach(&mut control, &mut records);
+    let first = control.started.take().expect("the start ran").expect("serves");
+    drop((control, records));
+    let mut world = match Rc::try_unwrap(shared) {
+        Ok(cell) => cell.into_inner(),
+        Err(_) => panic!("the fakes are dropped"),
+    };
+    let record = world.attachment;
+    // The daemon is killed while a client holds its device.
+    world.devices.get_mut(&first.number).expect("its device").state = DeviceState::Waiting;
+    world.held.push(first.number);
+    world.events.clear();
+    let second = run(world, 0);
+    let ready = second.result.expect("serves");
+    assert!(
+        ready.took_over && ready.number == first.number,
+        "detach answered {detached:?} and left the record {record:?}; the first start served \
+         device {}, and the next start serves device {} (took over: {}), devices {:?}",
+        first.number,
+        ready.number,
+        ready.took_over,
+        second.world.devices
+    );
+}
