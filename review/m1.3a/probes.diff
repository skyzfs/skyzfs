+/// A control for a `detach` that is overtaken by a start: the start
+/// runs in full at the n-th call the detach makes.
+struct Overtaken {
+    inner: Fake,
+    calls: usize,
+    at: usize,
+    started: Option<Result<Ready<Opened>, Stop>>,
+}
+
+impl Overtaken {
+    fn call(&mut self) {
+        if self.calls == self.at {
+            let shared = (self.inner).0.clone();
+            let (mut c, mut r, mut v) = (
+                Fake(shared.clone()),
+                Fake(shared.clone()),
+                Fake(shared.clone()),
+            );
+            let result = start_with(&mut c, &mut r, &mut v, &WANTED, Mutants::default());
+            if let Ok(ready) = &result {
+                // The daemon goes on to serve: the device is live.
+                let mut w = shared.borrow_mut();
+                if let Some(d) = w.devices.get_mut(&ready.number) {
+                    d.state = DeviceState::Live;
+                }
+            }
+            self.started = Some(result);
+        }
+        self.calls += 1;
+    }
+}
+
+impl Control for Overtaken {
+    fn can_reissue(&mut self) -> io::Result<bool> {
+        self.inner.can_reissue()
+    }
+    fn info(&mut self, number: u32) -> io::Result<Option<DeviceInfo>> {
+        let info = self.inner.info(number);
+        self.call();
+        info
+    }
+    fn add(&mut self, number: u32, shape: &Shape) -> Result<(), AddError> {
+        self.inner.add(number, shape)
+    }
+    fn disown(&mut self, number: u32) {
+        self.inner.disown(number)
+    }
+    fn delete(&mut self, number: u32) -> io::Result<()> {
+        self.inner.delete(number)
+    }
+    fn begin_recovery(&mut self, number: u32) -> io::Result<()> {
+        self.inner.begin_recovery(number)
+    }
+}
