## The candidate fix of N4 (scratch only), and the whole suite with it
diff --git a/crates/skyzfs-agent/src/plan.rs b/crates/skyzfs-agent/src/plan.rs
index eb371fc..c57e67d 100644
--- a/crates/skyzfs-agent/src/plan.rs
+++ b/crates/skyzfs-agent/src/plan.rs
@@ -618,6 +618,16 @@ fn onward(publish: &Publish, taken: &Taken, asked: Option<(u64, u64)>, seen: &Se
                 look(&|| give_up(pool, broken.unwrap_or(why)))
             }
             Reply::Withdrawn | Reply::Unknown | Reply::Expired => Action::Withdraw,
+            // The uploader's own end of the request, nothing published:
+            // no request of it pends, as after a withdraw answered so.
+            Reply::Refused(code @ (Code::Rewound | Code::State), _) => look(&|| {
+                let why = match broken {
+                    Some(Why::Destroyed) if *code == Code::Rewound => Why::Rewound,
+                    Some(broken) => broken,
+                    None => why,
+                };
+                give_up(pool, why)
+            }),
             _ => away(),
         };
     }

